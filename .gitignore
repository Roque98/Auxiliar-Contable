# Archivos locales con credenciales/secretos — nunca versionar
*.local.md
credenciales*.md

# Config local de Claude Code (por máquina)
.claude/settings.local.json

# Archivos temporales
*.tmp

# Variables de entorno locales (usa .env.example como plantilla)
.env
.env.local

