# Unidad systemd de la API. Copiar a /etc/systemd/system/zia-console.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now zia-console
[Unit]
Description=ZIA-Console API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
WorkingDirectory=/srv/zia-console/current/api
ExecStart=/usr/bin/dotnet /srv/zia-console/current/api/IgasConsole.HttpApi.Host.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=zia-console
User=zia
Group=zia

# Production apaga el explorador de BD (IsEnabled = IsDevelopment()). Si esto
# faltara, quedaria un CRUD directo a la base expuesto en produccion.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
# Kestrel solo en loopback: quien expone al mundo es nginx, con TLS.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5010
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

# Secretos y cadenas de conexion. NO van aqui: este archivo se versiona.
# Crear /etc/zia-console/env con permisos 600 y dueno zia (ver deploy/README.md).
EnvironmentFile=/etc/zia-console/env

# --- Endurecimiento -----------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Las unicas rutas escribibles: claves de DataProtection y logs.
ReadWritePaths=/var/lib/zia-console /var/log/zia-console

[Install]
WantedBy=multi-user.target
