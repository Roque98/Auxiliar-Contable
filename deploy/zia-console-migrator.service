# Aplica migraciones y seed. Unidad oneshot: se lanza a demanda desde deploy.sh con
#   systemctl start --wait zia-console-migrator
# Existe como unidad (y no como una linea suelta en deploy.sh) porque asi systemd
# parsea el EnvironmentFile correctamente: las cadenas de conexion llevan ';' y
# 'export $(grep ... | xargs)' las parte por la mitad.
[Unit]
Description=ZIA-Console - migraciones y seed
After=network.target postgresql.service

[Service]
Type=oneshot
# El DbMigrator lee la configuracion del DIRECTORIO ACTUAL, no del ensamblado.
WorkingDirectory=/srv/zia-console/staging/migrator
ExecStart=/usr/bin/dotnet /srv/zia-console/staging/migrator/IgasConsole.DbMigrator.dll
User=zia
Group=zia
SyslogIdentifier=zia-console-migrator

Environment=DOTNET_ENVIRONMENT=Production
EnvironmentFile=/etc/zia-console/env

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/zia-console
