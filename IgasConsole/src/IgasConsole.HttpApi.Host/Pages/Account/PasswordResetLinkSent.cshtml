@page
@model Volo.Abp.Account.Web.Pages.Account.PasswordResetLinkSentModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@inject IHtmlLocalizer<AccountResource> L
@*
    Sustituye la confirmación del módulo Account para decir lo mismo exista o no la cuenta
    (ver IgasConsoleForgotPasswordModel) y avisar de la carpeta de spam.
*@
<div class="card mt-3 shadow-sm rounded">
    <div class="card-body p-5">
        <h4>@L["ForgotPassword"]</h4>
        <form method="post" class="mt-4">
            <p>
                Si la cuenta existe, te enviamos un correo con el enlace para restablecer la
                contraseña. Puede tardar unos minutos.
                <br />
                Si no lo ves, revisa la carpeta de spam o correo no deseado.
            </p>
            <a abp-button="Primary" asp-page="./Login" asp-all-route-data="@(new Dictionary<string, string> {{"returnUrl", Model.ReturnUrl ?? string.Empty}, {"returnUrlHash", Model.ReturnUrlHash ?? string.Empty}})">&larr; @L["BackToLogin"]</a>
        </form>
    </div>
</div>
