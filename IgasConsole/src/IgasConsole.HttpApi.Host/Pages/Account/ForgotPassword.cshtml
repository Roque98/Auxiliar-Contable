@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@model IgasConsole.Pages.Account.IgasConsoleForgotPasswordModel
@inject IHtmlLocalizer<AccountResource> L
@*
    Sustituye la página del módulo Account de ABP. El único cambio real es el campo:
    ABP pide un correo (input type="email", que el propio navegador valida) y aquí se
    acepta también el nombre de usuario. Ver IgasConsoleForgotPasswordModel.
*@
<div class="card mt-3 shadow-sm rounded">
    <div class="card-body p-5">
        <h4>@L["ForgotPassword"]</h4>
        <form method="post" class="mt-4">
            <p>
                Escribe tu <b>usuario</b> o tu correo. El enlace para restablecer la
                contraseña te llegará por <b>Telegram</b>, al chat del bot que tengas
                vinculado — esta aplicación no envía correos.
            </p>

            <div class="mb-3">
                <label class="form-label" for="UserNameOrEmail">Usuario o correo</label>
                @* type="text" y no "email": con "email" el navegador rechaza "admin"
                   antes siquiera de enviar el formulario. *@
                <input type="text"
                       id="UserNameOrEmail"
                       name="UserNameOrEmail"
                       class="form-control"
                       autocomplete="username"
                       autofocus
                       value="@Model.UserNameOrEmail" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <abp-button button-type="Primary" type="submit" class="mt-2 mb-3">@L["Submit"]</abp-button>
            </div>

            <a asp-page="./Login" asp-all-route-data="@(new Dictionary<string, string> {{"returnUrl", Model.ReturnUrl ?? string.Empty}, {"returnUrlHash", Model.ReturnUrlHash ?? string.Empty}})">
                <i class="fa fa-long-arrow-left"></i> @L["Login"]
            </a>
        </form>
    </div>
</div>
