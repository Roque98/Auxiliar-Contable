<Project>

  <!-- Central Package Management: TODAS las versiones de paquetes viven aquí.
       Los .csproj referencian <PackageReference Include="..." /> sin Version. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Las versiones de aqui tambien mandan sobre las dependencias TRANSITIVAS: es lo que permite
         subir una dependencia vulnerable que trae otro paquete sin esperar a que ese paquete la suba. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Parches de seguridad de dependencias transitivas (las traen ABP, EF Core y compania).
         Quitar cuando el paquete que las trae ya pida una version igual o mayor. -->
    <!-- CVE-2026-84008 (DoS), corregida en 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- GHSA-qhrr-8q5h-9q3h (arreglos anidados), corregida en 3.1.9. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Terceros -->
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <!-- Texto de los PDF (CSF, estados de cuenta) para leerlos con codigo antes que con IA. MIT. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Drivers ADO.NET usados directamente por ExternalDataSourceConnectionFactory. -->
    <PackageVersion Include="Npgsql" Version="10.0.0" />
    <!-- Observabilidad (OpenTelemetry → OpenObserve; docs/observabilidad.md). Npgsql.OpenTelemetry
         va a la par de Npgsql para no arrastrar otra versión. -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <PackageVersion Include="IdentityModel" Version="7.0.0" />
    <PackageVersion Include="KubernetesClient" Version="18.0.5" />
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft / .NET -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.execution" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- ABP Framework (open source) — 10.6.0 -->
    <PackageVersion Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Authorization" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Caching" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Emailing" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.GlobalFeatures" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Swashbuckle" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TestBase" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.MultiTenancy" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.AspNetCore.Serilog" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Studio.Client.AspNetCore" Version="3.0.9" />
    <PackageVersion Include="Volo.Abp.Http.Client.IdentityModel" Version="10.6.0" />

    <!-- EF Core -->
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.6.0" />

    <!-- Theme (open source) -->
    <PackageVersion Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.6.0" />

    <!-- Account -->
    <PackageVersion Include="Volo.Abp.Account.Application" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Account.Application.Contracts" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Account.HttpApi" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Account.HttpApi.Client" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Account.Web.OpenIddict" Version="10.6.0" />

    <!-- Audit Logging -->
    <PackageVersion Include="Volo.Abp.AuditLogging.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.AuditLogging.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.AuditLogging.EntityFrameworkCore" Version="10.6.0" />

    <!-- Background Jobs -->
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Abstractions" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.EntityFrameworkCore" Version="10.6.0" />

    <!-- Blob Storing -->
    <PackageVersion Include="Volo.Abp.BlobStoring.Database.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.BlobStoring.Database.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.BlobStoring.Database.EntityFrameworkCore" Version="10.6.0" />
    <!-- Documentos de los clientes en el disco del VPS (cifrados por la app; CLAUDE.md 1.2.10). -->
    <PackageVersion Include="Volo.Abp.BlobStoring.FileSystem" Version="10.6.0" />

    <!-- Feature Management -->
    <PackageVersion Include="Volo.Abp.FeatureManagement.Application" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Application.Contracts" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.EntityFrameworkCore" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.HttpApi" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.FeatureManagement.HttpApi.Client" Version="10.6.0" />

    <!-- Identity -->
    <PackageVersion Include="Volo.Abp.Identity.Application" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Identity.AspNetCore" Version="10.6.0" />
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="SharpCompress" Version="1.0.0" />
    <PackageVersion Include="Volo.Abp.Identity.Application.Contracts" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Identity.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Identity.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Identity.EntityFrameworkCore" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Identity.HttpApi" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.Identity.HttpApi.Client" Version="10.6.0" />

    <!-- OpenIddict -->
    <PackageVersion Include="Volo.Abp.OpenIddict.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.OpenIddict.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.OpenIddict.EntityFrameworkCore" Version="10.6.0" />

    <!-- Permission Management -->
    <PackageVersion Include="Volo.Abp.PermissionManagement.Application" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Application.Contracts" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.Identity" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.OpenIddict" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.EntityFrameworkCore" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.HttpApi" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.PermissionManagement.HttpApi.Client" Version="10.6.0" />

    <!-- Setting Management -->
    <PackageVersion Include="Volo.Abp.SettingManagement.Application" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Application.Contracts" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.EntityFrameworkCore" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.HttpApi" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.SettingManagement.HttpApi.Client" Version="10.6.0" />

    <!-- Tenant Management -->
    <PackageVersion Include="Volo.Abp.TenantManagement.Application" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TenantManagement.Application.Contracts" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TenantManagement.Domain" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TenantManagement.Domain.Shared" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TenantManagement.EntityFrameworkCore" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TenantManagement.HttpApi" Version="10.6.0" />
    <PackageVersion Include="Volo.Abp.TenantManagement.HttpApi.Client" Version="10.6.0" />
  </ItemGroup>

  <!-- NetArchTest para los tests de arquitectura (Fase 3) -->
  <ItemGroup>
    <!-- Fork mantenido y compatible con .NET 10 (el NetArchTest.Rules original tiene
         un bug de NRE en la búsqueda de dependencias sobre .NET 10). Mismo API. -->
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="Respawn" Version="6.2.1" />

    <!-- Pin de seguridad: la 2.1.11 que arrastra Microsoft.EntityFrameworkCore.Sqlite
         tiene GHSA-2m69-gcr7-jv3q (High). Se referencia directamente en
         AuxiliarContable.EntityFrameworkCore.Tests para forzar la versión parcheada.
         Revisar si una versión futura de EF Core ya trae >= 2.1.13. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

</Project>
