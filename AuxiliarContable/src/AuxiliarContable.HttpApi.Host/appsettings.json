{
  "App": {
    "SelfUrl": "https://localhost:44338",
    "AngularUrl": "http://localhost:4201",
    "CorsOrigins": "https://*.AuxiliarContable.com,http://localhost:4201,",
    "RedirectAllowedUrls": "http://localhost:4201,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Nodos": {
    "//": "Carpeta del servidor con las versiones publicadas del programa del nodo (la llena nodo/publicar.sh).",
    "CarpetaDePublicaciones": ""
  },
  "Acceso": {
    "//": "Mueve el panel del host fuera de la raiz y el login fuera de /Account/Login.",
    "//SegmentoDelHost": "VACIO = comportamiento por defecto. En produccion llega por",
    "//SegmentoDelHost_2": "Acceso__SegmentoDelHost desde /etc/auxiliar-contable/env. Se deja",
    "//SegmentoDelHost_3": "vacio aqui a proposito: en Development no hay nada que esconder",
    "//SegmentoDelHost_4": "y un secreto versionado en el repositorio no es un secreto.",
    "SegmentoDelHost": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient.TelegramAlertNotifier": "Warning",
      "System.Net.Http.HttpClient.OtlpTraceExporter": "Warning",
      "System.Net.Http.HttpClient.OtlpMetricExporter": "Warning",
      "System.Net.Http.HttpClient.health-checks": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 52428800,
                "retainedFileTimeLimit": "30.00:00:00",
                "retainedFileCountLimit": 120
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=auxiliar_contable;Username=auxiliar_contable"
  },
  "DataSources": {},
  "AuthServer": {
    "Authority": "https://localhost:44338",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "AuxiliarContable_Swagger",
    "CertificatePassPhrase": ""
  },
  "StringEncryption": {
    "DefaultPassPhrase": ""
  },
  "Brevo": {
    "ApiKey": "",
    "SenderEmail": "",
    "SenderName": "Auxiliar contable",
    "SmsSender": "AuxContable",
    "SmsHabilitado": false,
    "WhatsAppSenderNumber": ""
  },
  "Claude": {
    "ApiKey": "",
    "Modelo": "claude-haiku-5-5",
    "MaxTokens": 8192,
    "TimeoutSegundos": 180,
    "Reintentos": 3
  },
  "ClaudeGateway": {
    "Url": "http://127.0.0.1:5050/",
    "Clave": "",
    "Modelo": "sonnet",
    "TimeoutSegundos": 240,
    "Reintentos": 2
  },
  "Settings": {
    "AuxiliarContable.Asistente.Habilitado": "false"
  },
  "MotorFiscal": {
    "Url": "http://127.0.0.1:5090/",
    "TimeoutSegundos": 20,
    "TimeoutDeBancosSegundos": 900
  },

  "Monitoring": {
    "IsEnabled": true,
    "DiskAlertPercent": 85,
    "CpuAlertPercent": 90,
    "MemoryAlertPercent": 90,
    "ErrorRateAlertPercent": 10,
    "ErrorRateMinRequests": 20,
    "RateLimitAbuseThreshold": 30
  },
  "RateLimiting": {
    "IsEnabled": true,
    "PermitLimit": 600,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "LoginPermitLimit": 10,
    "TokenPermitLimit": 120
  },
  "Security": {
    "AutoBlock": {
      "IsEnabled": true,
      "RejectionThreshold": 300,
      "WindowMinutes": 10,
      "BlockHours": 24,
      "MaxBlocksPerRun": 20,
      "ScanDetectionEnabled": true,
      "ScanFailureThreshold": 20,
      "ScanMinFailureRate": 80,
      "NeverBlock": [
        "127.0.0.1",
        "::1"
      ]
    }
  }
}
